# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_URL=

# Redis
REDIS_URL=redis://localhost:6379

# Security (JWT)
JWT_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Security (CORS) — whitelist explicite, jamais de "*" en production.
# Liste d'origines séparées par des virgules (Web App + Mobile App/dev).
CORS_ORIGINS=http://localhost:3001,http://localhost:8081

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

JWT_VALIDATION_SECRET=your-validation-secret-key
JWT_VALIDATION_EXPIRATION=7d
VALIDATION_BASE_URL=https://app.liyanza.com/validation

# URL publique de CETTE API (pas du frontend) — utilisée pour encoder la
# cible de GET /qr/:code dans l'image du QR code généré (BACK-305).
QR_CODE_BASE_URL=http://localhost:3000

# SMTP (BACK-302 — canal email du worker de notifications). En local via
# Docker Compose, pointe par défaut vers le service `mailhog` (aucune
# authentification, UI de consultation sur http://localhost:8025). En
# production (Render), renseigner un vrai relais SMTP.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=notifications@liyanza.local