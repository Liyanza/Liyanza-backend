# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_URL=

# Redis
REDIS_URL=redis://localhost:6379

# Security (JWT)
JWT_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Security (CORS) — whitelist explicite, jamais de "*" en production.
# Liste d'origines séparées par des virgules (Web App + Mobile App/dev).
CORS_ORIGINS=http://localhost:3001,http://localhost:8081

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

JWT_VALIDATION_SECRET=your-validation-secret-key
JWT_VALIDATION_EXPIRATION=7d
VALIDATION_BASE_URL=https://app.liyanza.com/validation

# URL publique de CETTE API (pas du frontend) — utilisée pour encoder la
# cible de GET /qr/:code dans l'image du QR code généré (BACK-305).
QR_CODE_BASE_URL=http://localhost:3000

# SMTP (BACK-302 — canal email du worker de notifications). En local via
# Docker Compose, pointe par défaut vers le service `mailhog` (aucune
# authentification, UI de consultation sur http://localhost:8025).
#
# En production (Render) : relais Brevo, SMTP_FROM sur le domaine
# kiyanza.com désormais vérifié (SPF/DKIM configurés chez Brevo + chez le
# registrar LWS) — indispensable pour éviter le classement en spam, un
# domaine non vérifiable (ex: notifications@liyanza.local) est
# systématiquement suspect pour les filtres anti-spam des destinataires.
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USER=<login du compte Brevo>
#   SMTP_PASSWORD=<clé SMTP générée dans Brevo, jamais le mot de passe du compte>
#   SMTP_FROM=notifications@kiyanza.com
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=notifications@kiyanza.com

# Stockage médias S3-compatible (BACK-307). En local via Docker Compose,
# pointe par défaut vers le service `minio` (console de consultation sur
# http://localhost:9001). Provider générique : fonctionne à l'identique avec
# AWS S3 (laisser S3_ENDPOINT vide), Cloudflare R2, Backblaze B2 ou tout
# autre stockage compatible S3 en production.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=liyanza-media
S3_ACCESS_KEY_ID=liyanza_minio_admin
S3_SECRET_ACCESS_KEY=liyanza_minio_password
S3_FORCE_PATH_STYLE=true

# Secret partagé protégeant POST /internal/monitoring/detections (BACK-304)
# — le futur service Liyanza-ia doit envoyer ce token dans le header
# X-Internal-Token. Générer une valeur aléatoire d'au moins 32 caractères
# (ex: openssl rand -hex 32), jamais la valeur d'exemple ci-dessous en prod.
INTERNAL_MONITORING_TOKEN=

# Intégration Meta Graph API (BACK-502/503/504) — OAuth Facebook/Instagram
# pour les campagnes digitales. App ID/Secret depuis le dashboard Meta for
# Developers de VOTRE App (Produit "Facebook Login" requis) — jamais commités.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v21.0
# Doit être enregistrée telle quelle dans "Valid OAuth Redirect URIs" côté
# Meta. `localhost` est accepté par Meta en développement.
META_OAUTH_REDIRECT_URI=http://localhost:3000/social-accounts/oauth/callback

# Clé de chiffrement des tokens Meta stockés (AES-256-GCM), base64 de 32
# octets. Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SOCIAL_TOKEN_ENCRYPTION_KEY=

# Deep link app mobile (ou URL de test) vers lequel rediriger une fois le
# compte Meta lié/refusé — jamais le token dans cette redirection.
SOCIAL_OAUTH_MOBILE_REDIRECT_URL=http://localhost:3000/social-accounts/oauth/result