# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_URL=

# Redis
REDIS_URL=redis://localhost:6379

# Security (JWT)
JWT_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Security (CORS) — whitelist explicite, jamais de "*" en production.
# Liste d'origines séparées par des virgules (Web App + Mobile App/dev).
CORS_ORIGINS=http://localhost:3001,http://localhost:8081

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=