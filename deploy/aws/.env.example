# Variables propres au déploiement AWS. Le reste (JWT, Meta, Google, Brevo,
# S3 médias, IA…) reprend les mêmes noms et valeurs que sur Render : voir le
# .env.example à la racine du dépôt.
#
# DATABASE_URL, REDIS_URL, PORT, NODE_ENV et TRUST_PROXY_HOPS sont fixés par
# docker-compose.yml : ne pas les définir ici.

# Domaine servi par Caddy (certificat HTTPS automatique)
PUBLIC_HOST=api.kiyanza.com

# Base locale (conteneur postgres)
POSTGRES_USER=kiyanza
POSTGRES_PASSWORD=
POSTGRES_DB=kiyanza
# Version majeure de PostgreSQL : au moins celle de la base d'origine
POSTGRES_VERSION=18

# Sauvegardes nocturnes (backup.sh)
BACKUP_BUCKET=kiyanza-backend-backups-922640335967
