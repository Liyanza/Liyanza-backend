generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Rôles applicatifs, alignés sur le besoin "sous-comptes & permissions" du cadrage.
/// Liste initiale à valider avec le PO — de nouvelles valeurs pourront être ajoutées
/// via une simple migration additive (ALTER TYPE ... ADD VALUE), sans réécriture
/// de données ni migration lourde.
enum Role {
  ADMIN
  MARKETING_MANAGER
  COMMUNITY_MANAGER
  PROVIDER
}

enum CampaignStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BroadcastStatus {
  PLANNED
  BROADCASTED
  MISSED
  CANCELLED
}

/// Entité ENTREPRISE du MCD — racine du multi-tenant.
model Company {
  id             String   @id @default(cuid())
  name           String
  businessSector String
  address        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime? 

  // Relation APPARTENIR_ENTREPRISE (côté 0,N : une entreprise a 0..N utilisateurs)
  users User[]
}

/// Entité UTILISATEUR du MCD.
model User {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String   @unique
  password  String
  phone     String
  role      Role
  createdAt DateTime @default(now())
  deactivatedAt DateTime?

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  // Back-relations ajoutées par BACK-103 / BACK-104
  campaigns     Campaign[]     // LANCER : campagnes lancées par cet utilisateur
  installations Installation[] // REALISER : prestations terrain réalisées par ce prestataire
  notifications Notification[] // RECEVOIR : notifications reçues par cet utilisateur

  @@index([companyId])
}

// =====================================================================
// BACK-103 — Campagnes, Canaux & Diffusion
// =====================================================================

model Campaign {
  id             String   @id @default(cuid())
  name           String
  startDate      DateTime
  endDate        DateTime
  plannedBudget  Decimal  @db.Decimal(12, 2)
  actualBudget   Decimal  @db.Decimal(12, 2)
  status         CampaignStatus @default(DRAFT)
  objective      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  launchedById   String
  launchedBy     User     @relation(fields: [launchedById], references: [id])

  channels       AdvertisingChannel[]
  broadcasts     Broadcast[]
  installations  Installation[]
  statistics     Statistic[]

  @@index([launchedById])
}

/// Entité CANAUX_PUBLICITAIRE du MCD.
/// NB : le MCD fourni (OCR, sans tracé des liens visibles) ne permet pas de déterminer
/// avec certitude le sens de COMPORTER. On retient ici l'interprétation la plus cohérente
/// avec le use case "Choisir les canaux de diffusion" (une campagne choisit plusieurs
/// canaux) : Campaign 1 --- N AdvertisingChannel. À reconfirmer en revue de schéma.
model AdvertisingChannel {
  id        String  @id @default(cuid())
  radio     Boolean
  poster    Boolean // affichePub
  flyer     Boolean

  // Relation COMPORTER (1,1 côté AdvertisingChannel : un canal appartient à une seule campagne)
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  // Relation REPARTIR (1,N côté AdvertisingChannel : un canal peut être réparti sur 1..N diffusions)
  broadcasts Broadcast[]

  @@index([campaignId])
}

model Broadcast {
  id             String   @id @default(cuid())
  mediaType      String
  scheduledAt    DateTime // dateHeureDiffusion prévue
  actualBroadcastAt DateTime? // dateHeureDiffusion réelle (ajout)
  duration       Int
  status         BroadcastStatus @default(PLANNED) // utilisation de l'enum
  audioProof     String?  // preuveAudio
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  campaignId     String
  campaign       Campaign @relation(fields: [campaignId], references: [id])
  channelId      String
  channel        AdvertisingChannel @relation(fields: [channelId], references: [id])

  @@index([campaignId])
  @@index([channelId])
}

// =====================================================================
// BACK-104 — Terrain, Preuves, IA & Notifications
// =====================================================================

/// Entité PRESTATION du MCD (tâche terrain : installation d'un support publicitaire).
model Installation {
  id                      String   @id @default(cuid())
  location                String   // emplacement
  plannedLatitude         Float    // latitudePrevue
  plannedLongitude        Float    // longitudePrevue
  plannedInstallationDate DateTime // dateInstallationPrevue
  status                  String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // Relation OUVRIR (1,1 côté Installation : une prestation est ouverte par une seule campagne)
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  // Relation REALISER (1,1 côté Installation : une prestation est réalisée par un seul prestataire)
  providerId String
  provider   User   @relation(fields: [providerId], references: [id])

  // Relation ATTESTER (1,1 / 1,1 : une prestation a exactement une preuve de publication)
  proof PublicationProof?

  // Relation SUIVRE (1,N côté Installation : une prestation a 1..N entrées d'historique)
  statusHistory StatusHistory[]

  @@index([campaignId])
  @@index([providerId])
}

/// Entité PREUVE_PUBLICATION du MCD.
model PublicationProof {
  id               String   @id @default(cuid())
  photo            String   // URL/chemin de la photo
  latitude         Float
  longitude        Float
  takenAt          DateTime // dateHeurePrise
  validationStatus String   // statutValidation
  createdAt        DateTime @default(now())

  // Relation ATTESTER (1,1 côté PublicationProof : une preuve atteste une seule prestation)
  installationId String       @unique
  installation   Installation @relation(fields: [installationId], references: [id])
}

/// Entité HISTORIQUE_STATUT du MCD.
model StatusHistory {
  id            String   @id @default(cuid())
  previousStatus String  // ancienStatut
  newStatus      String  // nouveauStatut
  changedAt      DateTime // dateChangement
  comment        String?  // commentaire

  // Relation SUIVRE (1,1 côté StatusHistory : une entrée d'historique appartient à une seule prestation)
  installationId String
  installation   Installation @relation(fields: [installationId], references: [id])

  @@index([installationId])
  @@index([changedAt])
}

/// Entité SIMULATION du MCD.
/// NB : le MCD fourni ne relie explicitement Simulation qu'à Questionnaire (REPOSE_SUR).
/// Aucun lien vers Campaign/User n'est spécifié dans les relations transmises — à valider
/// avec le PO si une simulation doit être rattachée à un utilisateur/une entreprise.
model Simulation {
  id               String   @id @default(cuid())
  estimatedBudget  Decimal  @db.Decimal(12, 2) // budgetEstime
  expectedResults  String   @db.Text            // resultatsPrevus
  simulatedAt      DateTime                     // dateSimulation
  /// Paramètres structurés de la simulation (JSON) — choix technique à valider en revue.
  parameters       Json                         // parametres

  // Relation REPOSE_SUR (1,1 / 1,1 : une simulation repose sur exactement un questionnaire)
  questionnaireId String     @unique
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id])
}

/// Entité QUESTIONNAIRE_SIMULATION du MCD.
model Questionnaire {
  id            String   @id @default(cuid())
  completedAt   DateTime // dateRealisation

  // Relation REPOSE_SUR — back-relation optionnelle vers la simulation générée
  simulation Simulation?

  // Relation CONTENIR (1,N côté Questionnaire : un questionnaire contient 1..N réponses)
  answers SimulationAnswer[]
}

/// Entité QUESTION du MCD (catalogue de questions réutilisables).
model Question {
  id        String @id @default(cuid())
  label     String // libelle
  fieldType String // typeChamp

  answers SimulationAnswer[]
}

/// Entité-association CONTENU du MCD (réification du lien N,N Questionnaire ↔ Question,
/// portant l'attribut valeurReponse).
model SimulationAnswer {
  id    String @id @default(cuid())
  value String // valeurReponse

  // Relation CONTENIR (1,1 côté SimulationAnswer : une réponse appartient à un seul questionnaire)
  questionnaireId String
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id])

  // Relation CONTENU (1,1 côté SimulationAnswer : une réponse répond à une seule question)
  questionId String
  question   Question @relation(fields: [questionId], references: [id])

  @@unique([questionnaireId, questionId])
  @@index([questionId])
}

/// Entité CONVERSATION_IA du MCD.
/// NB : aucune relation vers Utilisateur n'est listée dans les relations BACK-104 fournies
/// (seules ENGENDRER, ISSUE_DE, GENERER_STAT sont demandées) — à valider avec le PO si
/// une conversation doit être rattachée à son auteur.
model AiConversation {
  id        String   @id @default(cuid())
  startedAt DateTime // dateDebut
  topic     String   // sujet

  // Relation ENGENDRER (1,N côté AiConversation : une conversation engendre 1..N messages)
  messages AiMessage[]
}

/// Entité MESSAGE_IA du MCD.
model AiMessage {
  id        String   @id @default(cuid())
  content   String   @db.Text // contenu — texte libre, jamais de Varchar limité
  sender    String   // expediteur
  sentAt    DateTime // dateEnvoi

  // Relation ENGENDRER (1,1 côté AiMessage : un message appartient à une seule conversation)
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id])

  // Relation ISSUE_DE (0,1 / 0,1 : un message peut être à l'origine d'au plus une recommandation)
  recommendation Recommendation?

  @@index([conversationId])
  @@index([sentAt])
}

/// Entité RECOMMANDATION du MCD.
model Recommendation {
  id          String   @id @default(cuid())
  content     String   @db.Text // contenu — texte libre, jamais de Varchar limité
  priority    String   // priorite
  generatedAt DateTime // dateGeneration

  // Relation ISSUE_DE (0,1 côté Recommendation : optionnellement issue d'un message IA)
  sourceMessageId String?    @unique
  sourceMessage   AiMessage? @relation(fields: [sourceMessageId], references: [id])
}

/// Entité STATISTIQUE du MCD.
model Statistic {
  id         String   @id @default(cuid())
  indicator  String   // indicateur
  value      Float    // valeur
  computedAt DateTime // dateCalcul

  // Relation GENERER_STAT (1,1 côté Statistic : une statistique est générée par une seule campagne)
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
  @@index([computedAt])
}

/// Entité NOTIFICATION du MCD.
model Notification {
  id          String   @id @default(cuid())
  title       String   // titre
  message     String   @db.Text
  type        String
  sentAt      DateTime // dateEnvoi
  readStatus  String   // statutLecture

  // Relation RECEVOIR (1,1 côté Notification : une notification a un seul destinataire)
  recipientId String
  recipient   User   @relation(fields: [recipientId], references: [id])

  @@index([recipientId])
  @@index([sentAt])
}