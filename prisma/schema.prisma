generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Rôles applicatifs
enum Role {
  ADMIN
  MARKETING_MANAGER
  COMMUNITY_MANAGER
  PROVIDER
}

enum CampaignStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BroadcastStatus {
  PLANNED
  BROADCASTED
  MISSED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  LATE
}

enum QrCodeTargetType {
  WHATSAPP
  FORM
  PRODUCT_PAGE
  PROMO
}

enum MediaStatus {
  PENDING
  CONFIRMED
}

/// Entité ENTREPRISE – racine du multi-tenant.
model Company {
  id             String    @id @default(cuid())
  name           String
  businessSector String
  address        String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  users           User[]
  aiConversations AiConversation[] // ← nouvelle relation inverse
  recommendations Recommendation[] // ← nouvelle relation inverse
  tasks           Task[] // ← BACK-212
  media           Media[] // ← BACK-307
}

/// Entité UTILISATEUR
model User {
  id            String    @id @default(cuid())
  firstName     String
  lastName      String
  email         String    @unique
  password      String
  phone         String
  role          Role
  createdAt     DateTime  @default(now())
  deactivatedAt DateTime?

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  campaigns              Campaign[]
  installations          Installation[]
  notifications          Notification[]
  aiConversationsCreated AiConversation[] // ← nouvelle relation inverse (créateur)
  tasksCreated           Task[]           @relation("TaskCreatedBy") // ← BACK-212
  taskAssignments        TaskAssignee[] // ← BACK-212
  mediaUploaded          Media[] // ← BACK-307

  @@index([companyId])
}

// =====================================================================
// BACK-103 — Campagnes, Canaux & Diffusion
// =====================================================================

model Campaign {
  id            String         @id @default(cuid())
  name          String
  startDate     DateTime
  endDate       DateTime
  plannedBudget Decimal        @db.Decimal(12, 2)
  actualBudget  Decimal        @db.Decimal(12, 2)
  status        CampaignStatus @default(DRAFT)
  objective     String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  launchedById String
  launchedBy   User   @relation(fields: [launchedById], references: [id])

  channels        AdvertisingChannel[]
  broadcasts      Broadcast[]
  installations   Installation[]
  statistics      Statistic[]
  recommendations Recommendation[] // ← nouvelle relation inverse
  tasks           Task[] // ← BACK-212
  qrCodes         QrCode[] // ← BACK-305

  @@index([launchedById])
}

/// Entité CANAUX_PUBLICITAIRE
model AdvertisingChannel {
  id     String  @id @default(cuid())
  radio  Boolean
  poster Boolean
  flyer  Boolean

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  broadcasts Broadcast[]

  @@index([campaignId])
}

model Broadcast {
  id                String          @id @default(cuid())
  mediaType         String
  scheduledAt       DateTime
  actualBroadcastAt DateTime?
  duration          Int
  status            BroadcastStatus @default(PLANNED)
  audioProof        String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  campaignId String
  campaign   Campaign           @relation(fields: [campaignId], references: [id])
  channelId  String
  channel    AdvertisingChannel @relation(fields: [channelId], references: [id])

  @@index([campaignId])
  @@index([channelId])
}

// =====================================================================
// BACK-104 — Terrain, Preuves, IA & Notifications
// =====================================================================

model Installation {
  id                      String   @id @default(cuid())
  location                String
  plannedLatitude         Float
  plannedLongitude        Float
  plannedInstallationDate DateTime
  status                  String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  providerId String
  provider   User   @relation(fields: [providerId], references: [id])

  proof         PublicationProof?
  statusHistory StatusHistory[]
  qrCodes       QrCode[] // ← BACK-305

  @@index([campaignId])
  @@index([providerId])
}

model PublicationProof {
  id                String   @id @default(cuid())
  photo             String
  latitude          Float
  longitude         Float
  takenAt           DateTime
  validationStatus  String
  createdAt         DateTime @default(now())
  validationComment String?  @db.Text // ← BACK-308 : commentaire optionnel du publicitaire externe au retour

  installationId String       @unique
  installation   Installation @relation(fields: [installationId], references: [id])
}

model StatusHistory {
  id             String   @id @default(cuid())
  previousStatus String
  newStatus      String
  changedAt      DateTime
  comment        String?

  installationId String
  installation   Installation @relation(fields: [installationId], references: [id])

  @@index([installationId])
  @@index([changedAt])
}

/// Entité SIMULATION
model Simulation {
  id              String   @id @default(cuid())
  estimatedBudget Decimal  @db.Decimal(12, 2)
  expectedResults String   @db.Text
  simulatedAt     DateTime
  parameters      Json

  questionnaireId String        @unique
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id])
}

model Questionnaire {
  id          String   @id @default(cuid())
  completedAt DateTime

  simulation Simulation?
  answers    SimulationAnswer[]
}

model Question {
  id        String @id @default(cuid())
  label     String
  fieldType String

  answers SimulationAnswer[]
}

model SimulationAnswer {
  id    String @id @default(cuid())
  value String

  questionnaireId String
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id])

  questionId String
  question   Question @relation(fields: [questionId], references: [id])

  @@unique([questionnaireId, questionId])
  @@index([questionId])
}

/// Entité CONVERSATION_IA
model AiConversation {
  id          String   @id @default(cuid())
  startedAt   DateTime
  topic       String
  companyId   String?
  createdById String?

  company   Company? @relation(fields: [companyId], references: [id])
  createdBy User?    @relation(fields: [createdById], references: [id])

  messages AiMessage[]
}

/// Entité MESSAGE_IA
model AiMessage {
  id      String   @id @default(cuid())
  content String   @db.Text
  sender  String
  sentAt  DateTime

  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id])

  recommendation Recommendation?

  @@index([conversationId])
  @@index([sentAt])
}

/// Entité RECOMMANDATION
model Recommendation {
  id          String   @id @default(cuid())
  content     String   @db.Text
  priority    String
  generatedAt DateTime

  sourceMessageId String?    @unique
  sourceMessage   AiMessage? @relation(fields: [sourceMessageId], references: [id])

  campaignId String
  companyId  String?

  campaign Campaign @relation(fields: [campaignId], references: [id])
  company  Company? @relation(fields: [companyId], references: [id])
}

/// Entité STATISTIQUE
model Statistic {
  id         String   @id @default(cuid())
  indicator  String
  value      Float
  computedAt DateTime

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
  @@index([computedAt])
}

/// Entité NOTIFICATION
model Notification {
  id         String   @id @default(cuid())
  title      String
  message    String   @db.Text
  type       String
  sentAt     DateTime
  readStatus String

  recipientId String
  recipient   User   @relation(fields: [recipientId], references: [id])

  @@index([recipientId])
  @@index([sentAt])
}

// =====================================================================
// BACK-212 — Tâches d'équipe (gestion des tâches du tableau de bord)
// =====================================================================

model Task {
  id             String     @id @default(cuid())
  title          String
  description    String?    @db.Text
  status         TaskStatus @default(TODO)
  dueDate        DateTime?
  reminderSentAt DateTime? // ← BACK-306 : idempotence de la relance cron
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  createdById String
  createdBy   User   @relation("TaskCreatedBy", fields: [createdById], references: [id])

  assignees  TaskAssignee[]
  campaignId String?
  campaign   Campaign?      @relation(fields: [campaignId], references: [id])

  @@index([companyId])
  @@index([dueDate])
}

model TaskAssignee {
  taskId String
  userId String
  task   Task   @relation(fields: [taskId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@id([taskId, userId])
  @@index([userId])
}

// =====================================================================
// BACK-305 — QR Code intelligent (zoning & distribution)
// =====================================================================

model QrCode {
  id         String           @id @default(cuid())
  code       String           @unique
  targetType QrCodeTargetType
  targetUrl  String
  zone       String
  createdAt  DateTime         @default(now())

  installationId String?
  installation   Installation? @relation(fields: [installationId], references: [id])

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  scans QrCodeScan[]

  @@index([campaignId])
  @@index([zone])
}

model QrCodeScan {
  id        String   @id @default(cuid())
  scannedAt DateTime @default(now())

  qrCodeId String
  qrCode   QrCode @relation(fields: [qrCodeId], references: [id])

  @@index([qrCodeId])
  @@index([scannedAt])
}

// =====================================================================
// BACK-307 — Stockage médias (upload sécurisé, provider S3-compatible)
// =====================================================================

/// Suit le cycle de vie d'un fichier uploadé via URL présignée : PENDING dès
/// la demande d'upload (clé réservée côté stockage, fichier pas encore
/// confirmé), CONFIRMED une fois la présence réelle de l'objet vérifiée par
/// le serveur (`HeadObject`) — voir `MediaService.confirmUpload`.
model Media {
  id          String      @id @default(cuid())
  key         String      @unique
  contentType String
  sizeBytes   Int?
  status      MediaStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  confirmedAt DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  @@index([companyId])
  @@index([status])
}
